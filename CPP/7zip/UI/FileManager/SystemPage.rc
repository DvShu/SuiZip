// Modified 2026-11-17 for the fork: set the branded association prompt at runtime.
// Modified 2026-11-17 for the fork: label the association controls and explain their scope.
#include "SystemPageRes.h"
#include "../../GuiCommon.rc"

#define xc OPTIONS_PAGE_XC_SIZE
#define yc OPTIONS_PAGE_YC_SIZE

IDD_SYSTEM  DIALOG MY_PAGE_POSTFIX
CAPTION "System"
BEGIN
  LTEXT       "", IDT_SYSTEM_ASSOCIATE, m, m, xc, 8
  LTEXT       "Toggle selected types, or the whole column if none are selected.\nApplying changes for all users requires administrator access.", IDT_SYSTEM_TOGGLE_HELP, m, m + 11, xc, 18
  PUSHBUTTON  "Toggle current user associations", IDB_SYSTEM_CURRENT, m, m + 32, 140, bys
  PUSHBUTTON  "Toggle all users' associations", IDB_SYSTEM_ALL, m + 148, m + 32, 140, bys
  CONTROL     "List1", IDL_SYSTEM_ASSOCIATE, "SysListView32",
              LVS_REPORT | LVS_SHOWSELALWAYS | LVS_SHAREIMAGELISTS | LVS_NOSORTHEADER | WS_BORDER | WS_TABSTOP,
              m, m + 53, xc, (yc - 53)
END

#ifdef UNDER_CE

#undef m
#undef xc
#undef yc

#define m 4
#define xc (SMALL_PAGE_SIZE_X + 8)
#define yc (128 + 8)

IDD_SYSTEM_2  DIALOG MY_PAGE_POSTFIX
CAPTION "System"
BEGIN
  LTEXT       "", IDT_SYSTEM_ASSOCIATE, m, m, xc, 8
  LTEXT       "Toggle selected types, or all types if none are selected.", IDT_SYSTEM_TOGGLE_HELP, m, m + 11, xc, 18
  PUSHBUTTON  "Toggle associations", IDB_SYSTEM_CURRENT, m, m + 32, xc, bys
  CONTROL     "List1", IDL_SYSTEM_ASSOCIATE, "SysListView32",
              LVS_REPORT | LVS_SHOWSELALWAYS | LVS_SHAREIMAGELISTS | LVS_NOSORTHEADER | WS_BORDER | WS_TABSTOP,
              m, m + 53, xc, (yc - 53)
END

#endif

STRINGTABLE
BEGIN
  IDS_SYSTEM_ALL_USERS  "All users"
END
